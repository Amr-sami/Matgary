# Copy to .env and point at your machine.
# iOS simulator can also use http://127.0.0.1:3001
# Android emulator reaches the host at http://10.0.2.2:3001
EXPO_PUBLIC_API_URL=http://192.168.1.14:3001

# Dev-only convenience: prefills the login form (and optionally submits it) so
# the simulator does not have to be typed into. __DEV__ gated; stripped from
# release builds. Leave unset to get a normal empty login screen.
EXPO_PUBLIC_DEV_IDENTIFIER=
EXPO_PUBLIC_DEV_PASSWORD=
EXPO_PUBLIC_DEV_AUTOLOGIN=0
