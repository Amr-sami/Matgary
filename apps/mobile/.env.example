# Copy to .env and point at your machine.
# iOS simulator can also use http://127.0.0.1:3001
# Android emulator reaches the host at http://10.0.2.2:3001
# EXPO_PUBLIC_API_URL=
# Dev server port when 3001 is taken by another project (host stays auto-derived).
# EXPO_PUBLIC_API_PORT=3003

# Dev-only convenience: prefills the login form (and optionally submits it) so
# the simulator does not have to be typed into. __DEV__ gated; stripped from
# release builds. Leave unset to get a normal empty login screen.
EXPO_PUBLIC_DEV_IDENTIFIER=
EXPO_PUBLIC_DEV_PASSWORD=
EXPO_PUBLIC_DEV_AUTOLOGIN=0

# Dev-only: force a locale for screenshots. Unset = whatever the user chose.
# EXPO_PUBLIC_DEV_LOCALE=en

# --- Sentry (doc 06 §10.2) ---------------------------------------------------
# Runtime DSN for the `thestoro-mobile` project. Unset = error reporting off (dev default).
EXPO_PUBLIC_SENTRY_DSN=
# Performance-trace sample rate, 0..1. Default 0.1 mirrors the web's SENTRY_TRACES_RATE;
# raise per-incident, never fleet-wide (every POS device shares one quota).
# EXPO_PUBLIC_SENTRY_TRACES_RATE=0.1
# Build-time only (EAS secrets): org + project the @sentry/react-native/expo plugin uploads
# source maps and Hermes debug info to. Never EXPO_PUBLIC_ — they must not reach the bundle.
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry auth token with project:releases + org:read scopes; used for the source-map upload.
SENTRY_AUTH_TOKEN=
