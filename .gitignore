# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# user uploads (employee photos, etc.) — served via authenticated routes only
/uploads

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# legacy / leftover from earlier work
/apps
/infra/data
/public/startissue.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local config (per-machine settings, scheduled-tasks lock, etc.)
.claude/

# local scratch (seed / verify logs)
/tmp

# per-machine docker port remaps / service tweaks
docker-compose.override.yml

# Playwright shared-owner storage state — provisioned per dev box
tests/e2e/.auth/
tests/perf/.cookies/

